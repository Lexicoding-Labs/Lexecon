--- /dev/null
+++ b/tools/required_tool_gate.py
@@ -0,0 +1,168 @@
+"""Opt-in, process-pinned tool mediation for a trusted local plugin host.
+
+This is a dispatch boundary, not a sandbox for arbitrary Python code. The
+operator arms before plugin discovery and seals the registered handlers after
+discovery. Live reload cannot expand this process's authority.
+"""
+
+from __future__ import annotations
+
+import threading
+from dataclasses import dataclass, field
+from typing import Any, Callable
+
+from hermes_constants import hermes_home_key
+
+
+class RequiredToolGateError(RuntimeError):
+    """Content-free startup failure safe for an operator-facing diagnostic."""
+
+
+@dataclass(frozen=True)
+class _Requirement:
+    plugin: str
+    tools: frozenset[str]
+
+
+@dataclass(frozen=True)
+class _Pin:
+    entry: Any
+    handler: Callable
+    is_async: bool
+    registration: Any
+
+
+@dataclass
+class _State:
+    requirement: _Requirement | None = None
+    manager: Any = None
+    plugin: Any = None
+    pins: dict[str, _Pin] = field(default_factory=dict)
+    sealed: bool = False
+
+
+_states: dict[str, _State] = {}
+_lock = threading.RLock()
+_MESSAGE = "Required tool gate denied execution; restart the approved profile after checking its configuration."
+
+
+def _requirements() -> _Requirement | None:
+    from hermes_cli.config import load_config_readonly, require_readable_config_before_write
+
+    # Unlike the ordinary config reader, this rejects malformed/unreadable YAML
+    # instead of collapsing it to defaults. It performs no writes or migration.
+    require_readable_config_before_write()
+    config = load_config_readonly() or {}
+    if "required_tool_gate" not in config:
+        return None
+    raw = config["required_tool_gate"]
+    if not isinstance(raw, dict) or set(raw) != {"plugin", "tools"}:
+        raise RequiredToolGateError(_MESSAGE)
+    plugin, names = raw["plugin"], raw["tools"]
+    if (not isinstance(plugin, str) or not plugin.strip() or plugin != plugin.strip()
+            or not isinstance(names, list) or not names
+            or any(not isinstance(name, str) or not name or name != name.strip() for name in names)
+            or len(set(names)) != len(names)):
+        raise RequiredToolGateError(_MESSAGE)
+    return _Requirement(plugin, frozenset(names))
+
+
+def arm_from_config() -> bool:
+    """Latch this home's requirement before discovery; never disarm/reconfigure it."""
+    home = hermes_home_key()
+    with _lock:
+        try:
+            requirement = _requirements()
+        except Exception:
+            _states.setdefault(home, _State())
+            raise RequiredToolGateError(_MESSAGE) from None
+        previous = _states.get(home)
+        if previous is not None:
+            if requirement != previous.requirement or requirement is None:
+                raise RequiredToolGateError(_MESSAGE)
+            return True
+        if requirement is None:
+            return False
+        _states[home] = _State(requirement=requirement)
+        return True
+
+
+def seal_required_gate() -> None:
+    """Pin actual host-owned plugin registrations after successful discovery."""
+    from hermes_cli.plugins import get_plugin_manager
+    from tools.registry import registry
+
+    home = hermes_home_key()
+    with _lock:
+        state = _states.get(home)
+        if state is None or state.requirement is None:
+            raise RequiredToolGateError(_MESSAGE)
+        if _requirements() != state.requirement:
+            raise RequiredToolGateError(_MESSAGE)
+        if state.sealed:
+            if any(mandatory_block(name) for name in state.pins):
+                raise RequiredToolGateError(_MESSAGE)
+            return
+        manager = get_plugin_manager()
+        plugin = manager._plugins.get(state.requirement.plugin)
+        if (not manager._discovered or plugin is None or not plugin.enabled
+                or plugin.error or plugin.deferred or plugin.module is None):
+            raise RequiredToolGateError(_MESSAGE)
+        owned = manager._ownership_ledger.get(state.requirement.plugin, ())
+        pins = {}
+        for name in state.requirement.tools:
+            entry = registry.get_entry(name, scope=home)
+            registration = next((item for item in owned if item.kind == "tool"
+                                 and item.key == name and item.active), None)
+            if (entry is None or registration is None or name not in plugin.tools_registered
+                    or not callable(entry.handler)
+                    or (not getattr(entry.handler, "__module__", "").startswith(plugin.module.__name__ + ".")
+                        and getattr(entry.handler, "__module__", "") != plugin.module.__name__)):
+                raise RequiredToolGateError(_MESSAGE)
+            pins[name] = _Pin(entry, entry.handler, entry.is_async, registration)
+        state.manager, state.plugin, state.pins, state.sealed = manager, plugin, pins, True
+
+
+def mandatory_block(name: str, entry=None, scope=None) -> str | None:
+    """Return a safe denial; errors, reloads, profile drift and unarmed config close."""
+    try:
+        home = hermes_home_key()
+        with _lock:
+            state = _states.get(home)
+            requirement = _requirements()
+            if state is None:
+                return _MESSAGE if requirement is not None or _states else None
+            if (not state.sealed or requirement != state.requirement
+                    or scope is not None and hermes_home_key(scope) != home):
+                return _MESSAGE
+            pin = state.pins.get(name)
+            if pin is None:
+                return _MESSAGE
+            from hermes_cli.plugins import get_plugin_manager
+            from tools.registry import registry
+
+            manager = get_plugin_manager()
+            live = registry.get_entry(name, scope=home)
+            if (manager is not state.manager or not manager._discovered
+                    or manager._plugins.get(requirement.plugin) is not state.plugin
+                    or not state.plugin.enabled or state.plugin.error or state.plugin.deferred
+                    or not pin.registration.active or live is not pin.entry
+                    or entry is not None and entry is not pin.entry
+                    or live.handler is not pin.handler or live.is_async != pin.is_async):
+                return _MESSAGE
+            return None
+    except Exception:
+        return _MESSAGE
+
+
+def checked_handler(name, entry, scope=None):
+    """Return the checked callable snapshot; never reread a mutable handler later."""
+    with _lock:
+        blocked = mandatory_block(name, entry=entry, scope=scope)
+        if blocked:
+            return blocked, None, False
+        state = _states.get(hermes_home_key())
+        if state is not None:
+            pin = state.pins[name]
+            return None, pin.handler, pin.is_async
+        return None, entry.handler, entry.is_async
