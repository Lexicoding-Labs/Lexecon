+def test_duplicated_directory_retains_guard_after_original_closes(protected_home, tmp_path):
+    """Descriptor-relative plugin reads work without bypassing protected roots."""
+    (tmp_path / "allowed.txt").write_text("allowed", encoding="utf-8")
+    original = os.open(tmp_path, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        duplicated = os.dup(original)
+    finally:
+        os.close(original)
+    try:
+        permitted = os.open("allowed.txt", os.O_RDONLY, dir_fd=duplicated)
+        try:
+            assert os.read(permitted, 32) == b"allowed"
+        finally:
+            os.close(permitted)
+        with pytest.raises(AssertionError, match="REAL hermes home"):
+            os.open("protected/file.txt", os.O_RDONLY, dir_fd=duplicated)
+    finally:
+        os.close(duplicated)
+
+
