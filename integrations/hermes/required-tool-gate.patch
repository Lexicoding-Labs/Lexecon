+        @wraps(original_dup)
+        def guarded_dup(fd):
+            # A duplicated directory retains the same path authority after the
+            # original descriptor closes; never exempt it from guarded opens.
+            parent = self.directories.get(fd)
+            duplicated = original_dup(fd)
+            if parent is not None:
