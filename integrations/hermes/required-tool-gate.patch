diff --git a/tests/tools/test_required_tool_gate.py b/tests/tools/test_required_tool_gate.py
new file mode 100644
index 00000000..f8b2d780
--- /dev/null
+++ b/tests/tools/test_required_tool_gate.py
@@ -0,0 +1,290 @@
+"""Local pilot integration: real Lexecon plugin, host dispatch, fixture-only API.
+
+Run with scripts/run_tests.sh. The sibling Lexecon release checkout is the
+explicit integration fixture; no live profile, account, model or socket is used.
+"""
+
+import importlib
+import json
+import shutil
+import socket
+import sys
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+PLUGIN = Path(__file__).resolve().parents[3] / "lexecon-release-review-2026-10-07/integrations/hermes/lexecon_gate"
+ALLOWED = ["lexecon_list_files", "lexecon_read_file"]
+
+
+@pytest.fixture(autouse=True)
+def isolated_required_state(monkeypatch):
+    from tools import required_tool_gate
+
+    monkeypatch.setattr(required_tool_gate, "_states", {})
+
+
+def parse(result):
+    return json.loads(result) if isinstance(result, str) else result
+
+
+def prepare_home(base, *, enabled=True):
+    home = base.resolve() / "home"
+    home.mkdir(parents=True, mode=0o700)
+    for name in ("workspace", "private", "plugins"):
+        (home / name).mkdir(mode=0o700)
+    assert PLUGIN.is_dir(), "The Lexecon sibling checkout is required for this local integration suite"
+    shutil.copytree(PLUGIN, home / "plugins/lexecon-gate", ignore=shutil.ignore_patterns("__pycache__"))
+    (home / "workspace/hello.txt").write_text("bounded workspace content")
+    settings = {"workspace_root": str(home / "workspace"), "username": "hermes-test",
+                "session_file": str(home / "private/session"), "audit_file": str(home / "private/audit.jsonl")}
+    config = {"required_tool_gate": {"plugin": "lexecon-gate", "tools": ALLOWED},
+              "plugins": {"enabled": ["lexecon-gate"] if enabled else [],
+                          "entries": {"lexecon-gate": {"settings": settings}}},
+              "platform_toolsets": {"cli": ["lexecon_workspace"]},
+              "tools": {"tool_search": {"enabled": False}}}
+    (home / "config.yaml").write_text(json.dumps(config))
+    return home, config
+
+
+def load_home(home, config, monkeypatch):
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+    from hermes_cli import plugins
+    from tools import required_tool_gate as required
+
+    token = set_hermes_home_override(home)
+    try:
+        required.arm_from_config()
+        model_tools = importlib.import_module("model_tools")
+        plugins.discover_plugins(force=True)
+        try:
+            required.seal_required_gate()
+        except required.RequiredToolGateError:
+            if config["plugins"]["enabled"]:
+                raise
+        manager = plugins.get_plugin_manager()
+        loaded = manager._plugins.get("lexecon-gate")
+        return SimpleNamespace(home=home, config=config, required=required, plugins=plugins,
+                               manager=manager, module=None if loaded is None else loaded.module,
+                               model=model_tools)
+    finally:
+        reset_hermes_home_override(token)
+
+
+@pytest.fixture
+def pilot(tmp_path, monkeypatch):
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+    from hermes_cli import plugins
+
+    def forbidden(*args, **kwargs):
+        raise AssertionError("Network connection forbidden in required-gate tests")
+
+    monkeypatch.setattr(socket.socket, "connect", forbidden)
+    monkeypatch.setattr(socket.socket, "connect_ex", forbidden)
+    monkeypatch.setattr(socket, "create_connection", forbidden)
+    monkeypatch.setenv("HERMES_ENABLE_PROJECT_PLUGINS", "0")
+    home, config = prepare_home(tmp_path)
+    monkeypatch.chdir(home / "workspace")
+    plugins._reset_plugin_managers_for_tests()
+    gate = load_home(home, config, monkeypatch)
+    token = set_hermes_home_override(home)
+    try:
+        assert gate.module is not None
+        yield gate
+    finally:
+        reset_hermes_home_override(token)
+        plugins._reset_plugin_managers_for_tests()
+
+
+def fixture_api(pilot, monkeypatch, *, deny=False):
+    runtime = sys.modules[pilot.module.__name__ + ".runtime"]
+    requests = []
+
+    def post(self, path, payload):
+        requests.append((path, payload))
+        if path == "/decide":
+            return {"decision": "deny" if deny else "permit", "decision_id": "fixture-decision",
+                    "capability_token": {"arguments_digest": runtime.arguments_digest(payload["tool_arguments"])}}
+        assert path == "/capability/verify"
+        return {"valid": True, "consumed": True}
+
+    monkeypatch.setattr(runtime.LoopbackClient, "for_call", lambda self: self)
+    monkeypatch.setattr(runtime.LoopbackClient, "whoami", lambda self: {
+        "user": {"username": "hermes-test", "role": "viewer"}})
+    monkeypatch.setattr(runtime.LoopbackClient, "post", post)
+    return requests
+
+
+def call(pilot, name, args=None, **kwargs):
+    return parse(pilot.model.handle_function_call(name, args or {}, "fixture-task",
+                                                 session_id="fixture-session", **kwargs))
+
+
+def test_required_mode_blocks_before_loading_or_sealing(tmp_path, monkeypatch):
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+    from tools import required_tool_gate as required
+    from tools.registry import registry
+
+    home, _ = prepare_home(tmp_path)
+    token = set_hermes_home_override(home)
+    try:
+        effects = []
+        registry.register(name="required_gate_sentinel", toolset="test", schema={},
+                          handler=lambda args: effects.append(args) or '{}', scope=str(home))
+        required.arm_from_config()
+        assert parse(registry.dispatch("required_gate_sentinel", {})).get("error")
+        assert effects == []
+    finally:
+        reset_hermes_home_override(token)
+
+
+@pytest.mark.parametrize("route", ["normal", "registry", "invoke"])
+def test_allowed_handlers_authorize_and_deny_every_route(pilot, monkeypatch, route):
+    from agent.agent_runtime_helpers import invoke_tool
+
+    agent = SimpleNamespace(session_id="test", valid_tool_names=set(ALLOWED), _context_engine=None,
+                            _memory_manager=None, enabled_toolsets=["lexecon_workspace"], _current_turn_id="")
+    routes = {
+        "normal": lambda: call(pilot, ALLOWED[1], {"path": "hello.txt"}),
+        "registry": lambda: parse(pilot.model.registry.dispatch(ALLOWED[1], {"path": "hello.txt"})),
+        "invoke": lambda: parse(invoke_tool(agent, ALLOWED[1], {"path": "hello.txt"}, "test",
+                                             pre_tool_block_checked=True, skip_tool_request_middleware=True,
+                                             skip_tool_execution_middleware=True)),
+    }
+    requests = fixture_api(pilot, monkeypatch)
+    assert routes[route]()["content"] == "bounded workspace content"
+    assert [path for path, _ in requests] == ["/decide", "/capability/verify"]
+    fixture_api(pilot, monkeypatch, deny=True)
+    assert routes[route]().get("error") == "policy_denied"
+
+
+@pytest.mark.parametrize("name", ["terminal", "read_file", "execute_code", "delegate_task", "tool_call",
+                                "tool_search", "connectors", "memory", "todo", "unmapped"])
+def test_all_unmapped_routes_block_without_effects(pilot, monkeypatch, name):
+    from agent.agent_runtime_helpers import invoke_tool
+
+    effects = []
+    pilot.model.registry.register(name=name, toolset="test", schema={},
+                                 handler=lambda args: effects.append(args) or '{}', scope=str(pilot.home), override=True)
+    agent = SimpleNamespace(session_id="test", valid_tool_names={name})
+    assert call(pilot, name, {}, skip_pre_tool_call_hook=True).get("error")
+    assert parse(pilot.model.registry.dispatch(name, {})).get("error")
+    assert parse(invoke_tool(agent, name, {}, "test", pre_tool_block_checked=True)).get("error")
+    assert effects == []
+
+
+@pytest.mark.parametrize("failure", ["unload", "disabled", "handler_replaced", "entry_replaced", "foreign_scope"])
+def test_seal_rejects_changed_owner_handler_or_scope(pilot, monkeypatch, failure):
+    fixture_api(pilot, monkeypatch)
+    effects = []
+    handler = lambda args, **kwargs: effects.append(args) or '{}'
+    scope = None
+    if failure == "unload":
+        pilot.manager.unload("lexecon-gate")
+    elif failure == "disabled":
+        pilot.manager._plugins["lexecon-gate"].enabled = False
+    elif failure == "handler_replaced":
+        monkeypatch.setattr(pilot.model.registry.get_entry(ALLOWED[1]), "handler", handler)
+    elif failure == "entry_replaced":
+        pilot.model.registry.register(name=ALLOWED[1], toolset="test", schema={}, handler=handler,
+                                      scope=str(pilot.home), override=True)
+    else:
+        scope = str(pilot.home.parent / "foreign")
+        pilot.model.registry.register(name=ALLOWED[1], toolset="test", schema={}, handler=handler,
+                                      scope=scope, override=True)
+    assert parse(pilot.model.registry.dispatch(ALLOWED[1], {"path": "hello.txt"}, scope=scope)).get("error")
+    assert effects == []
+
+
+@pytest.mark.parametrize("config", [{}, {"required_tool_gate": None}, {"required_tool_gate": {"plugin": "other"}}])
+def test_removed_or_malformed_config_does_not_disarm(pilot, monkeypatch, config):
+    fixture_api(pilot, monkeypatch)
+    (pilot.home / "config.yaml").write_text(json.dumps(config))
+    assert call(pilot, ALLOWED[1], {"path": "hello.txt"}).get("error")
+    assert call(pilot, "terminal", {}).get("error")
+
+
+def test_missing_plugin_remains_blocked(tmp_path, monkeypatch):
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+    home, config = prepare_home(tmp_path, enabled=False)
+    pilot = load_home(home, config, monkeypatch)
+    token = set_hermes_home_override(home)
+    try:
+        assert call(pilot, ALLOWED[1], {"path": "hello.txt"}).get("error")
+        assert call(pilot, "terminal", {}).get("error")
+    finally:
+        reset_hermes_home_override(token)
+
+
+def test_final_rewritten_arguments_are_reauthorized(pilot, monkeypatch):
+    requests = fixture_api(pilot, monkeypatch)
+    pilot.manager._hooks["pre_tool_call"].append(
+        lambda **kwargs: {"action": "modify", "args": {"path": "../outside.txt"}})
+    assert call(pilot, ALLOWED[1], {"path": "hello.txt"}).get("error")
+    assert requests == []
+
+
+def test_parallel_calls_each_reach_bound_consumption(pilot, monkeypatch):
+    from tools.thread_context import propagate_context_to_thread
+
+    requests = fixture_api(pilot, monkeypatch)
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        futures = [pool.submit(propagate_context_to_thread(
+            lambda: call(pilot, ALLOWED[1], {"path": "hello.txt"}))) for _ in range(8)]
+        results = [future.result(timeout=10) for future in futures]
+    assert all(result.get("content") == "bounded workspace content" for result in results), results
+    assert sum(path == "/capability/verify" for path, _ in requests) == 8
+
+
+@pytest.mark.parametrize("concurrent", [False, True])
+def test_shared_sequential_parallel_authorizer_blocks_before_effects(pilot, monkeypatch, concurrent):
+    from agent import tool_executor
+
+    effects = []
+    observed = []
+    monkeypatch.setattr(tool_executor, "_emit_terminal_post_tool_call",
+                        lambda *args, **kwargs: observed.append(kwargs))
+    ref = tool_executor._ToolCallRef("delegate_task", {}, "test", "test-call", [])
+    state = tool_executor._ManagedToolResult(None, {}, [], False, False)
+    start_order = lambda callback=None: effects.append("start") if callback else None
+    result = tool_executor._dispatch_authorized_once(
+        SimpleNamespace(session_id="test"), state, ref,
+        execute=lambda args: effects.append("executed"), scope_block=None, display_index=None,
+        begin_execution=start_order if concurrent else None, authorization_gate=None)
+    assert parse(result).get("error")
+    assert state.blocked is True
+    assert effects == []
+    assert observed[0]["status"] == "blocked"
+
+
+def test_outer_hook_infrastructure_failure_cannot_enable_unmapped_tool(pilot, monkeypatch):
+    effects = []
+    pilot.model.registry.register(name="unsafe_fixture", toolset="test", schema={},
+                                 handler=lambda args: effects.append(args) or '{}', scope=str(pilot.home))
+    def broken(*args, **kwargs):
+        raise RuntimeError("hook infrastructure failure")
+    monkeypatch.setattr(pilot.plugins, "_dispatch_pre_tool_call_hooks", broken)
+    assert call(pilot, "unsafe_fixture", {}).get("error")
+    assert effects == []
+
+
+def test_profile_a_b_a_never_shares_workspace_or_seal(pilot, tmp_path, monkeypatch):
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+    fixture_api(pilot, monkeypatch)
+    (pilot.home / "workspace/hello.txt").write_text("A")
+    assert call(pilot, ALLOWED[1], {"path": "hello.txt"})["content"] == "A"
+    home_b, config_b = prepare_home(tmp_path / "B")
+    other = load_home(home_b, config_b, monkeypatch)
+    fixture_api(other, monkeypatch)
+    (home_b / "workspace/hello.txt").write_text("B")
+    token = set_hermes_home_override(home_b)
+    try:
+        assert call(other, ALLOWED[1], {"path": "hello.txt"})["content"] == "B"
+        assert parse(other.model.registry.dispatch(ALLOWED[1], {"path": "hello.txt"}, scope=str(pilot.home))).get("error")
+    finally:
+        reset_hermes_home_override(token)
+    assert call(pilot, ALLOWED[1], {"path": "hello.txt"})["content"] == "A"
